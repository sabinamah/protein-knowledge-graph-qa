# Copy to .env and fill in. .env is git-ignored.

# --- Neo4j connection ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=thesisgraph123

# --- NL -> Cypher reasoning backend ---
# One of: template | anthropic | ollama
# "template" needs no key or GPU and always works (rule-based).
LLM_BACKEND=template

# Needed only when LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Needed only when LLM_BACKEND=ollama (local model server)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
